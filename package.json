{
  "name": "trial-prescreening-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Trial-first prescreening agent for oncology research coordinators (synthetic demo data only).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "ai:probe": "NODE_OPTIONS=--conditions=react-server tsx scripts/ai-probe.ts",
    "ai:smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/ai-smoke.ts",
    "ai:workflow-smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/ai-workflow-smoke.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@openai/agents": "0.21.0",
    "better-sqlite3": "^12.11.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": true
  }
}
