# Copy this file to .env and set your own values. .env is gitignored.
# OpenAI API key used server-side only by the model adapter and setup probe.
# Never commit the real key. Obtain one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Explicit adapter selection. Fixture = deterministic simulation, never live AI.
# Run npm run ai:probe to verify and pin live models before choosing live.
AI_MODE=fixture

# SQLite database file, relative to the project root. Created by `npm run setup`.
DATABASE_PATH=./data/app.db

# Enables demo-only controls (synthetic replies, clock advance). true or false.
DEMO_MODE=true

# IANA timezone for business-day and reminder timing. Timestamps are stored in UTC.
CLINIC_TIMEZONE=America/New_York
